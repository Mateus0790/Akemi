# Copie para .env e preencha. Nunca faça commit do .env.

# ---------------------------------------------------------------- Cérebro
# Providers: nim | openai | ollama | llamacpp | anthropic | echo (offline/teste)
BRAIN_PROVIDER=nim
# Modelo rápido: triagem do filtro de atenção, chat da live, respostas curtas
FAST_MODEL=nvidia/ising-calibration-1.5-31b
# Modelo profundo: só para perguntas complexas do dono (planejar, explicar, código)
DEEP_MODEL=openai/gpt-oss-20b
# Opcional: usar outro provider só para o modelo profundo
# DEEP_PROVIDER=anthropic
LLM_TIMEOUT_S=30
LLM_TEMPERATURE=0.8

NVIDIA_API_KEY=nvapi-coloque-sua-chave-aqui
# NIM_BASE_URL=https://integrate.api.nvidia.com/v1
# OPENAI_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434/v1
# LLAMACPP_BASE_URL=http://localhost:8080/v1
# ANTHROPIC_API_KEY=

# --- Cérebro reserva (docs/INDEPENDENCIA.md) ---
# Se o cérebro principal cair (internet, NIM fora do ar, sem chave), ela troca
# sozinha para o próximo da lista e volta quando o principal se recupera.
# Instale o Ollama e baixe um modelo: ollama pull qwen2.5:7b
# BRAIN_FALLBACK=["ollama"]
# FALLBACK_FAST_MODEL=qwen2.5:7b
# FALLBACK_DEEP_MODEL=
# BRAIN_RETRY_AFTER_S=120

# ---------------------------------------------------- Personalidade/estado
OWNER_NAME=Mateus
# PERSONA_FILE=akemi/brain/persona.yaml
# (se existir data/persona.yaml, vinda de um chip, ela vale mais que PERSONA_FILE)

# --- Projeto Capricórnio (docs/CAPRICORNIO.md) ---
# Nome deste corpo; vazio = nome do computador. Ela percebe quando troca de corpo.
# BODY_NAME=pc-do-quarto
# Chave para assinar os chips de identidade (akemi-chip). Com ela definida,
# só entram chips assinados com a mesma chave. Gere uma com:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# CHIP_KEY=
# A cada quantos segundos ela revisa as conversas e propõe mudanças em si (0 = só /evoluir)
# SELF_IMPROVE_INTERVAL_S=21600
# SELF_IMPROVE_MIN_CONVERSATIONS=6
# Ela muda sozinha (e te conta). false = as mudanças esperam /aprovar
# SELF_IMPROVE_AUTONOMOUS=true
# Memória: a cada quantos segundos ela resume as lembranças antigas (0 = só /resumir)
# MEMORY_CONSOLIDATE_INTERVAL_S=21600
# Lembranças mais novas que isso (em dias) ficam inteiras; as mais velhas viram resumo
# MEMORY_KEEP_DAYS=7
DATA_DIR=data

# ------------------------------------------------------------- Autonomia
# A cada quantos segundos ela tem um "momento de pensamento" (0 desliga)
IDLE_THINK_INTERVAL_S=180
# Intervalo mínimo entre falas espontâneas (não pedidas)
MIN_SECONDS_BETWEEN_UNPROMPTED_SPEECH=60
# Iniciativa (estilo J.A.R.V.I.S.): nos momentos de pensamento ela pode fazer
# sozinha uma destas ações e te conta o que fez. /pausar desliga.
# INITIATIVE_ENABLED=true
# INITIATIVE_ACTIONS=["criar_tarefa", "concluir_tarefa", "lembrete", "midia", "volume"]
# INITIATIVE_MAX_PER_HOUR=6

# ------------------------------------------------------------------ Live
# Chat da live (teste no console com /chat <nick> <mensagem>)
CHAT_BATCH_WINDOW_S=6
CHAT_MAX_REPLIES_PER_MINUTE=6

# ------------------------------------------------------------- Percepção
# Ouvir o áudio do PC (WASAPI loopback, só Windows) e transcrever com Whisper
SYSTEM_AUDIO_ENABLED=false
WHISPER_MODEL=small
STT_LANGUAGE=pt
VAD_AGGRESSIVENESS=2

# Microfone (pip install -e ".[mic]"). Liste os dispositivos com: akemi --listar-mics
MIC_ENABLED=false
# MIC_DEVICE=
# wake_word = só responde se ouvir o nome dela (ou logo após uma conversa)
# always    = tudo que você falar é para ela
MIC_MODE=wake_word
WAKE_WORDS=["akemi"]
# Segundos para continuar a conversa sem repetir o nome
FOLLOWUP_WINDOW_S=20
# Volume mínimo para interromper enquanto ela fala (evita ela se interromper
# com a própria voz vazando da caixa de som). Com fone, pode baixar.
BARGE_IN_RMS=1500
# Reconhecer você pela voz (docs/VOZ.md): pip install -e ".[voz]", baixe o
# modelo e rode akemi --cadastrar-voz. Sem cadastro, o microfone vale como você.
# VOICE_ID_ENABLED=true
# VOICE_MODEL_PATH=data/voices/wespeaker_en_voxceleb_resnet34.onnx

# ----------------------------------------------------------------- Visão
# Olhar a tela (pip install -e ".[vision]" + Tesseract com idioma português)
SCREEN_ENABLED=false
# 1 = monitor principal, 2 = segundo monitor...
SCREEN_MONITOR=1
SCREEN_INTERVAL_S=5
# Fração da tela que precisa mudar para ela ler de novo
SCREEN_CHANGE_THRESHOLD=0.06
OCR_LANG=por+eng
# Caminho do tesseract.exe, se não estiver no PATH nem na pasta padrão
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# Pasta com os idiomas (por/eng.traineddata). Se existir, é usada no lugar da
# pasta do Tesseract — dá para adicionar português sem ser administrador.
# TESSDATA_DIR=data/tessdata
# Trechos de título de janela que ela nunca lê. Vazio = lista padrão
# (senha, password, gerenciadores de senha, banco, aba anônima...)
# SCREEN_IGNORE_WINDOWS=["senha", "banco", "whatsapp"]
# Modelo de visão para entender jogos/vídeos/imagens (vazio = só OCR).
# NIM: meta/llama-3.2-11b-vision-instruct | Ollama: qwen2.5vl, llava
# VISION_MODEL=meta/llama-3.2-11b-vision-instruct
# VISION_PROVIDER=
VISION_DESCRIBE_INTERVAL_S=45

# ------------------------------------------------------------- Arquivos
# "analisa a pasta X e me conta" em segundo plano (docs/ARQUIVOS.md).
# Sem nenhuma pasta aqui, ela não lê arquivo nenhum. PDF: pip install -e ".[arquivos]"
# FILES_ALLOWED_DIRS=["C:/Users/voce/Documents/Projetos"]
# FILES_ENABLED=true
# FILES_MAX_PER_RUN=12
# Com modelo na nuvem fica desligado, porque o conteúdo sairia do PC:
# FILES_ALLOW_CLOUD=false

# ------------------------------------------------------------------ Voz
# fish    = voz principal: Fish Audio na nuvem (pip install -e ".[fish]")
# kokoro  = voz local feminina pt-BR, pf_dora (pip install -e ".[kokoro]")
# piper   = voz local masculina pt-BR (pip install -e ".[tts]")
# console = fala aparece no terminal
TTS_ENGINE=console
# --- Fish Audio (voz principal) ---
# Chave em https://fish.audio/app/api-keys. Com ela, "akemi --voz" já usa o Fish.
# FISH_API_KEY=
# Id da voz: o final do link da voz no site (fish.audio/m/<id>). Vazio = voz padrão
# FISH_VOICE_ID=
# s2.1-pro (recomendado) | s2.1-pro-free (grátis, para testar) | s2-pro
# FISH_MODEL=s2.1-pro
# balanced/low = começa a falar antes | normal = um pouco mais de qualidade
# FISH_LATENCY=balanced
# FISH_SPEED=1.0
# Ganho em dB (-3 mais baixo, 3 mais alto)
# FISH_VOLUME_DB=0
# Vazio = detecta o idioma sozinho
# FISH_LANGUAGE=pt
# Voz reserva se o Fish cair (sem internet, sem créditos): auto | kokoro | piper | console
# auto = a voz local que você tiver baixado (Kokoro, depois Piper)
# TTS_FALLBACK=auto
# Baixe com: python -m piper.download_voices pt_BR-faber-medium --data-dir data/voices
# Kokoro: baixe o modelo e as vozes (ver akemi/tts/kokoro_engine.py)
# KOKORO_VOICE=pf_dora
# Mais suave (177 MB): baixe kokoro-v1.0.fp16.onnx do mesmo link e aponte aqui
# KOKORO_MODEL_PATH=data/voices/kokoro/kokoro-v1.0.fp16.onnx
# KOKORO_SPEED=1.0
# Piper
PIPER_MODEL_PATH=data/voices/pt_BR-faber-medium.onnx
# >1 fala mais devagar, <1 mais rápido
PIPER_LENGTH_SCALE=1.0
PIPER_VOLUME=1.0
# Saída de áudio (nome ou índice). Vazio = padrão. Útil para mandar a voz
# para um cabo virtual (VB-Cable) e capturar no OBS.
# TTS_OUTPUT_DEVICE=

# ------------------------------------------------- Núcleo (servidor) e corpo (PC)
# Senha entre o núcleo (Docker no ZimaOS) e o corpo (este PC). A mesma nos dois.
# Também é a senha do app do celular (akemi --celular, docs/CELULAR.md).
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(24))"
AKEMI_TOKEN=
# No PC: onde está o núcleo (akemi-corpo usa isso se não passar --servidor)
# SERVER_URL=ws://192.168.0.10:8765
# No servidor: onde escutar
# SERVER_HOST=0.0.0.0
# SERVER_PORT=8765

# ---------------------------------------------------- Modo Casca (docs/CAPRI.md)
# Modo Casca: ligue com "akemi --casca claude|codex|ambos". auto = o que você ligou.
# CASCA=auto
# nada (não fala; veja com /casca) | importante (fala quando pedem seu OK, terminam ou dão erro) | tudo
# CASCA_VOZ=importante

# ------------------------------------------------ Clipes pelo OBS (docs/CAPRI.md)
# "clipa isso" salva o replay buffer. pip install -e ".[obs]"
# OBS_ENABLED=false
# OBS_URL=ws://127.0.0.1:4455
# OBS_PASSWORD=
# OBS_REPLAY_AUTOSTART=true

# ------------------------------------------------- Modo chamada (docs/CAPRI.md)
# Cabo virtual onde a voz dela entra na call (VB-Cable). Vazio = sem modo chamada.
# CALL_OUTPUT_DEVICE=CABLE Input
# Ao entrar, ela se apresenta e avisa que está ouvindo
# CALL_ANNOUNCE=true
# Amigos na call podem pedir ações; só o seu "sim" executa
# CALL_FRIENDS_CAN_ASK=false
# CALL_FRIEND_ACTIONS=["abrir_programa","abrir_site","pesquisar","midia","volume"]

# ------------------------------------- Secretária nos chats (docs/SECRETARIA.md)
# "tô em reunião até as 15h" e ela responde quem te manda mensagem, anota os recados
# e conta quando você volta. /dm <contato> <msg> no terminal testa sem nenhum chat.
# SECRETARIA_ENABLED=false
# ocupado = só enquanto você está ocupado | sempre = responde toda mensagem
# SECRETARIA_QUANDO=ocupado
# Ponte HTTP (POST /mensagem). Senha: vazio = AKEMI_TOKEN (mínimo 16 caracteres)
# SECRETARIA_TOKEN=
# 0.0.0.0 para um app no celular alcançar o PC pela rede de casa
# SECRETARIA_HOST=127.0.0.1
# SECRETARIA_PORT=8766
# SECRETARIA_GRUPOS=false
# SECRETARIA_IGNORAR=["Chefe","5511999999999"]
# SECRETARIA_MAX_POR_CONTATO=4
# Telegram (token do @BotFather). Com Telegram Business, ela responde na sua conta.
# TELEGRAM_BOT_TOKEN=

# ---------------------------------------------------------------- Oficina
# Ela muda o próprio código e abre PR para você revisar (docs/OFICINA.md).
# Token fine-grained só deste repositório: Contents e Pull requests (escrita).
# OFICINA_ENABLED=false
# GITHUB_TOKEN=
# GITHUB_REPO=Mateus0790/Akemi
# OFICINA_PER_DAY=2

# ------------------------------------------------- Apps por MCP (docs/MCP.md)
# Ela usa as ferramentas dos servidores MCP de outros apps. Sem arquivo, nada muda.
# Mesmo formato do Claude Desktop/Cursor. Vários arquivos: separe com ";"
# MCP_CONFIG=data/mcp.json
# MCP_CONFIG=data/mcp.json;%APPDATA%\Claude\claude_desktop_config.json
# MCP_ENABLED=true
# MCP_TIMEOUT_S=60
# Na primeira vez o npx baixa o servidor
# MCP_CONNECT_TIMEOUT_S=90
# Cada ferramenta ocupa espaço no prompt
# MCP_MAX_TOOLS=60
# MCP_RESULT_MAX_CHARS=4000
# Tokens para o mcp.json (lá use "${GITHUB_MCP_TOKEN}")
# GITHUB_MCP_TOKEN=

# ----------------------------------------------------------------- Rede
CONTROL_API_HOST=127.0.0.1
CONTROL_API_PORT=8765

# ------------------------------------------------------------------ Logs
LOG_LEVEL=INFO
LOG_JSON=false
