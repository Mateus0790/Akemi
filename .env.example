# Copie para .env e preencha. Nunca faça commit do .env.

# ---------------------------------------------------------------- Cérebro
# Providers: nim | openai | ollama | llamacpp | anthropic | echo (offline/teste)
BRAIN_PROVIDER=nim
# Modelo rápido: triagem do filtro de atenção, chat da live, respostas curtas
FAST_MODEL=meta/llama-3.1-8b-instruct
# Modelo profundo: só para perguntas complexas do dono (planejar, explicar, código)
DEEP_MODEL=meta/llama-3.3-70b-instruct
# Opcional: usar outro provider só para o modelo profundo
# DEEP_PROVIDER=anthropic
LLM_TIMEOUT_S=30
LLM_TEMPERATURE=0.8

NVIDIA_API_KEY=nvapi-coloque-sua-chave-aqui
# NIM_BASE_URL=https://integrate.api.nvidia.com/v1
# OPENAI_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434/v1
# LLAMACPP_BASE_URL=http://localhost:8080/v1
# ANTHROPIC_API_KEY=

# ---------------------------------------------------- Personalidade/estado
OWNER_NAME=Mateus
# PERSONA_FILE=akemi/brain/persona.yaml
DATA_DIR=data

# ------------------------------------------------------------- Autonomia
# A cada quantos segundos ela tem um "momento de pensamento" (0 desliga)
IDLE_THINK_INTERVAL_S=180
# Intervalo mínimo entre falas espontâneas (não pedidas)
MIN_SECONDS_BETWEEN_UNPROMPTED_SPEECH=60

# ------------------------------------------------------------------ Live
# Deixe TWITCH_CHANNEL vazio para não conectar
TWITCH_CHANNEL=
# Sem nick/token conecta anônimo (só leitura, suficiente para responder por voz)
TWITCH_NICK=
TWITCH_OAUTH_TOKEN=
CHAT_BATCH_WINDOW_S=6
CHAT_MAX_REPLIES_PER_MINUTE=6

# ------------------------------------------------------------- Percepção
# Ouvir o áudio do PC (WASAPI loopback, só Windows) e transcrever com Whisper
SYSTEM_AUDIO_ENABLED=false
WHISPER_MODEL=small
STT_LANGUAGE=pt
VAD_AGGRESSIVENESS=2

# ----------------------------------------------------------------- Rede
HERMES_API_URL=http://192.168.0.10:5000
CONTROL_API_HOST=127.0.0.1
CONTROL_API_PORT=8765

# ------------------------------------------------------------------ Logs
LOG_LEVEL=INFO
LOG_JSON=false
