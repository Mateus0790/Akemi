"""Tipos do módulo nativo ``akemi_audio_rs`` (Rust). Veja docs/RUST.md."""

__version__: str

def downmix_to_mono_int16(pcm: bytes, channels: int) -> bytes: ...
def resample_int16(
    samples: bytes, src_rate: int, dst_rate: int, carry: bytes | None = None
) -> tuple[bytes, bytes]: ...

class StreamResampler:
    src_rate: int
    dst_rate: int
    pending: int
    def __init__(self, src_rate: int, dst_rate: int) -> None: ...
    def push(self, samples: bytes) -> bytes: ...
    def clear(self) -> None: ...

class FrameAssembler:
    frame_bytes: int
    pending: int
    def __init__(self, frame_bytes: int) -> None: ...
    def push(self, data: bytes) -> list[bytes]: ...
    def clear(self) -> None: ...

class AudioPipeline:
    device_rate: int
    output_rate: int
    channels: int
    frame_bytes: int
    frames_out: int
    def __init__(self, device_rate: int, channels: int, output_rate: int = 16000, frame_ms: int = 20) -> None: ...
    def push(self, data: bytes) -> list[bytes]: ...
    def clear(self) -> None: ...

class Vad:
    sample_rate: int
    aggressiveness: int
    def __init__(self, aggressiveness: int = 2, sample_rate: int = 16000) -> None: ...
    def set_mode(self, aggressiveness: int) -> None: ...
    def is_speech(self, frame: bytes, sample_rate: int | None = None) -> bool: ...
